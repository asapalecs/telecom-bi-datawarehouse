# Copiaza in .env si ajusteaza (.env este ignorat de git).

# Motor tinta: sqlite (implicit) sau sqlserver
DW_ENGINE=sqlite

# SQL Server (doar cand DW_ENGINE=sqlserver)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=TelecomDW
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Generare date
N_CUSTOMERS=5000
START_DATE=2023-01-01
END_DATE=2025-12-31
RANDOM_SEED=42
